pipeline {
    agent any

    stages {

        stage('Get Code') {
            steps {
                git 'https://github.com/briss/unir_devops-cloud_cp1.git'
                stash name: 'code', includes: '**'
            }
        }

        stage('Unit Tests') {
            environment {
                PYTHONPATH = "$WORKSPACE"
            }
            steps {
                unstash name: 'code'
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '''
                        coverage run --branch --source=app --omit=app/__init__.py,app/api.py -m pytest --junitxml=result-unit.xml test/unit
                        coverage xml
                    '''
                }
                junit 'result-unit.xml'
                recordCoverage(
                    tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']],
                    qualityGates: [
                        [integerThreshold: 85, threshold: 85.0, metric: 'LINE', baseline: 'PROJECT', criticality: 'ERROR'],
                        [integerThreshold: 95, threshold: 95.0, metric: 'LINE', baseline: 'PROJECT'],
                        [integerThreshold: 80, threshold: 80.0, metric: 'BRANCH', baseline: 'PROJECT', criticality: 'ERROR'],
                        [integerThreshold: 90, threshold: 90.0, metric: 'BRANCH', baseline: 'PROJECT'],
                    ]
                )
            }
            post {
                always {
                    deleteDir()
                }
            }
        }

        stage('Rest Tests') {
            environment {
                PYTHONPATH = "$WORKSPACE"
            }
            steps {
                unstash name: 'code'
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '''
                        flask --app app/api.py --debug run &
                        sleep 2
                        pytest --junitxml=result-rest.xml test/rest
                    '''
                }
                junit 'result-rest.xml'
            }
            post {
                always {
                    deleteDir()
                }
            }
        }

        stage('Static Test') {
            steps {
                unstash name: 'code'
                sh 'flake8 --format=pylint --exit-zero app > flake8.out'
                recordIssues(
                    tools:[flake8(name: 'Flake8', pattern: 'flake8.out')],
                    qualityGates: [
                        [threshold: 8, type: 'TOTAL', unstable: true],
                        [threshold: 10, type: 'TOTAL', unstable: false]
                    ]
                )
            }
            post {
                always {
                    deleteDir()
                }
            }
        }

        stage('Security Test') {
            steps {
                unstash name: 'code'
                sh 'bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}({severity})] {msg}"'
                recordIssues(
                    tools:[pyLint(name: 'Bandit', pattern: 'bandit.out')],
                    qualityGates: [
                        [threshold: 2, type: 'TOTAL', unstable: true],
                        [threshold: 4, type: 'TOTAL', unstable: false]
                    ]
                )
            }
            post {
                always {
                    deleteDir()
                }
            }
        }

        stage('Performance Test') {
            steps {
                unstash name: 'code'
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '''
                        flask --app app/api.py --debug run &
                        sleep 2
                        jmeter -n -t test/jmeter/flask.jmx -f -l flask.jtl
                    '''
                    performanceReport sourceDataFiles: 'flask.jtl'
                }
            }
            post {
                always {
                    deleteDir()
                }
            }
        }
    }
}
